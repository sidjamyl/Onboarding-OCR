{
  "name": "@ocr-algeria/onboarding-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=../.env dist/src/server.js",
    "worker": "node --env-file-if-exists=../.env dist/src/worker.js",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "benchmark": "npm run build && node dist/src/quality/benchmark.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "admin:create": "node --env-file-if-exists=../.env dist/src/management/create-admin.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1140.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/swagger": "^9.5.2",
    "better-auth": "1.7.6",
    "fastify": "^5.6.2",
    "pg": "^8.16.3",
    "pg-boss": "^10.3.2",
    "pino": "^9.9.5",
    "ppu-ocv": "4.0.0",
    "sharp": "^0.35.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
