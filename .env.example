# The exact HTTPS URL served by Tailscale Serve (or another TLS proxy).
PUBLIC_BASE_URL=https://app.example-tailnet.ts.net
# The browser uses the frontend's same-origin proxy by default. Override only
# when the backend is intentionally exposed on another public origin.
BROWSER_API_URL=/api/onboarding
# Tailscale Serve terminates HTTPS and proxies to this loopback listener.
ONBOARDING_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
BACKEND_PORT=8090
# Set to a stable absolute server path when Compose runs from a CI checkout.
ONBOARDING_DATA_DIR=./backend/.local
# Keep false in production. Enable only for the local, unauthenticated demo landing page.
DEMO_MODE_ENABLED=false
# Customer message changes after this much active OCR time; no fake ETA is shown.
OCR_SLOW_THRESHOLD_MS=20000

# Client integration. Multiple API keys can be comma-separated.
CLIENT_API_KEYS=replace-with-your-client-api-key
ONBOARDING_API_KEY=replace-with-your-client-api-key
# Set a unique server-only secret to enable /admin. Never expose it with NEXT_PUBLIC_.
# BETTER_AUTH_SECRET=<random-secret-at-least-32-characters>
# For several clients, replace CLIENT_API_KEYS with explicit registrations:
# CLIENT_APPLICATIONS_JSON=[{"id":"partner-a","apiKey":"partner-a-key","allowedPolicies":["two-of-three"],"webhookDestinations":[{"id":"main","url":"https://partner.example/webhook","secret":"partner-webhook-secret"}],"returnDestinations":[]}]

# PostgreSQL and MinIO. Choose your own strong values.
POSTGRES_DB=onboarding
POSTGRES_USER=onboarding
POSTGRES_PASSWORD=replace-with-your-postgres-password
MINIO_ACCESS_KEY=onboarding
MINIO_SECRET_KEY=replace-with-your-minio-password
MINIO_BUCKET=onboarding-captures

# Gateway base URL: verification and all extraction routes use this one setting.
# Host-run onboarding + local Gateway: http://127.0.0.1:8080
# Docker-run onboarding + host Gateway: http://host.docker.internal:8080
# Remote Gateway example below. Restart BOTH backend and worker after changing it.
OCR_BASE_URL=http://100.126.225.103:8080
OCR_BASIC_USERNAME=replace-with-ocr-username
OCR_BASIC_PASSWORD=replace-with-ocr-password
OCR_TIMEOUT_MS=200000
# Temporary local testing only. Phone checks and Gateway ORB remain enabled.
SERVER_QUALITY_CHECKS_ENABLED=true
# Local, opt-in debugging only: stores document photos and diagnostic JSON outside Git.
# Never enable in production; erase captured traces when testing is finished.
ONBOARDING_DEMO_TRACE=false
ONBOARDING_TRACE_DIRECTORY=.local/traces

# Optional completion notification. The OCR result is never included in the webhook.
# WEBHOOK_URL=https://client.example.com/webhooks/onboarding
WEBHOOK_SECRET=replace-with-your-webhook-signing-secret

# JSON can override or extend required fields without changing code.
# REQUIRED_FIELDS_JSON={"dz-id":["lastNameLatin","firstNameLatin","nin","dateOfBirth"]}

# Keep production here on a deployed server. Use development only for the local calibration laboratory.
ONBOARDING_NODE_ENV=production
QUALITY_LAB_ENABLED=false
QUALITY_MODE=observe
# Exported by /dev/quality-lab. Leave empty to use the defaults.
QUALITY_PROFILE_JSON=
TEMPLATE_DIRECTORY=/app/templates

# Optional encrypted off-server backups (enable with: docker compose --profile backup up -d).
# RESTIC_REPOSITORY=s3:https://s3.example.com/ocr-onboarding-backups
# RESTIC_PASSWORD=replace-with-your-backup-encryption-password
# BACKUP_S3_ACCESS_KEY_ID=replace-with-your-s3-key
# BACKUP_S3_SECRET_ACCESS_KEY=replace-with-your-s3-secret
# BACKUP_INTERVAL_SECONDS=86400
